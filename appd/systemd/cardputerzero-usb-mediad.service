[Unit]
Description=CardputerZero isolated USB mass-storage exchange
Requires=cardputerzero-usb-mediad.socket cardputerzero-storaged.socket
After=cardputerzero-usb-mediad.socket cardputerzero-storaged.socket local-fs.target systemd-modules-load.service
RequiresMountsFor=/sys/kernel/config /var/lib/cardputerzero

[Service]
Type=simple
ExecStart=/usr/libexec/cardputerzero/cp0-usb-mediad serve
ExecStop=/usr/libexec/cardputerzero/cp0-usb-mediad emergency-stop
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStartSec=30
TimeoutStopSec=45
MemoryMax=64M
MemorySwapMax=0
TasksMax=24
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_SYS_ADMIN CAP_CHOWN
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rw
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cardputerzero/usb-media /var/lib/cardputerzero/documents /sys/kernel/config/usb_gadget
InaccessiblePaths=-/var/lib/cardputerzero/data -/var/lib/cardputerzero/apps -/var/lib/cardputerzero/registry -/var/lib/cardputerzero/store -/var/lib/cardputerzero/provisioning -/var/lib/cardputerzero/developer -/var/lib/extrausers -/etc/shadow -/etc/gshadow -/etc/cardputerzero/trust -/etc/cardputerzero/authorized_keys
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
