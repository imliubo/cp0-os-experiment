#!/bin/sh
set -eu

output=${1:?generator output directory is required}
complete=/var/lib/cardputerzero/provisioning/complete
enabled=/var/lib/cardputerzero/provisioning/ssh-enabled
developer=/var/lib/cardputerzero/registry/developer-mode

[ -f "$complete" ] && [ ! -L "$complete" ] || exit 0
if ! { [ -f "$enabled" ] && [ ! -L "$enabled" ]; } &&
   ! { [ -f "$developer" ] && [ ! -L "$developer" ]; }; then
    exit 0
fi
mkdir -p "$output/multi-user.target.wants"
ln -s /usr/lib/systemd/system/ssh.service \
    "$output/multi-user.target.wants/ssh.service"
