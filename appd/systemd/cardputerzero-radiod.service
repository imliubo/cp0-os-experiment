[Unit]
Description=CardputerZero restricted LoRa radio broker
Requires=cardputerzero-radiod.socket
After=cardputerzero-radiod.socket

[Service]
Type=simple
ExecStart=/usr/libexec/cardputerzero/cp0-radiod serve
User=cp0-radio
Group=cp0-radio
SupplementaryGroups=spi
UMask=0077
Restart=on-failure
RestartSec=500ms
TimeoutStopSec=5
MemoryMax=8M
MemorySwapMax=0
TasksMax=8
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/spidev0.1 rw
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
