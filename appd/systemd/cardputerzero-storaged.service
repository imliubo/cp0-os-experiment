[Unit]
Description=CardputerZero quota-enforced private storage broker
Requires=cardputerzero-storaged.socket
After=cardputerzero-storaged.socket

[Service]
Type=simple
ExecStart=/usr/libexec/cardputerzero/cp0-storaged serve
User=cp0-storage
Group=cp0-storage
UMask=0077
Restart=on-failure
RestartSec=500ms
TimeoutStopSec=5
MemoryMax=16M
MemorySwapMax=0
TasksMax=8
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cardputerzero/data
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
