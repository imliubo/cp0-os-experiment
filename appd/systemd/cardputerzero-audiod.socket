[Unit]
Description=CardputerZero privileged audio broker socket

[Socket]
ListenStream=/run/cardputerzero-audiod/audio.sock
FileDescriptorName=audio
Service=cardputerzero-audiod.service
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
