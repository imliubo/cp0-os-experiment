[Unit]
Description=CardputerZero application capability broker socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/cardputerzero-broker/runtime.sock
FileDescriptorName=broker
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0711
Accept=no
Service=cardputerzero-appd.service

[Install]
WantedBy=sockets.target
