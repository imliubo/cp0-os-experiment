[Unit]
Description=CardputerZero first-boot provisioning broker
Requires=cardputerzero-provisiond.socket
After=cardputerzero-provisiond.socket NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/cardputerzero/cp0-provisiond serve
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=500ms
TimeoutStopSec=5
MemoryMax=16M
MemorySwapMax=0
TasksMax=12
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN
AmbientCapabilities=CAP_CHOWN CAP_NET_ADMIN
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/cardputerzero/provisioning /var/lib/extrausers /home /etc/NetworkManager/system-connections
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
