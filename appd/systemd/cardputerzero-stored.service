[Unit]
Description=CardputerZero signed application store client
Requires=cardputerzero-stored.socket cardputerzero-appd.socket
After=cardputerzero-stored.socket cardputerzero-appd.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/libexec/cardputerzero/cp0-stored
User=cp0-store
Group=cp0-store
SupplementaryGroups=cp0-control
UMask=0077
Restart=on-failure
RestartSec=500ms
TimeoutStopSec=5
MemoryMax=40M
MemorySwapMax=0
TasksMax=8
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cardputerzero/store /run/cardputerzero-appd/store
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
