IMAGE_PROFILE=$(cat "${EXPORT_DIR}/image-profile")
case "$IMAGE_PROFILE" in
    product) IMG_SUFFIX="-cp0-os-dev" ;;
    recovery) IMG_SUFFIX="-cp0-os-recovery" ;;
    *)
        echo "error: invalid CardputerZero image profile: $IMAGE_PROFILE" >&2
        return 1
        ;;
esac
if [ "${USE_QEMU}" = "1" ]; then
    export IMG_SUFFIX="${IMG_SUFFIX}-qemu"
fi
