[Unit]
Description=CardputerZero single-foreground Wayland compositor
Documentation=https://wayland.pages.freedesktop.org/weston/toc/running-weston.html
Requires=seatd.service dev-dri-cardputer\x2dzero\x2dinternal.device dev-input-cardputer\x2dzero\x2dinternal.device
After=seatd.service systemd-user-sessions.service dev-dri-cardputer\x2dzero\x2dinternal.device dev-input-cardputer\x2dzero\x2dinternal.device
RequiresMountsFor=/var/lib/cardputerzero/registry
Wants=cardputerzero-system-shell.service
Before=cardputerzero-system-shell.service
Conflicts=getty@tty1.service
OnFailure=cardputerzero-recovery-console.service
ConditionPathExists=!/var/lib/cardputerzero/registry/recovery-mode
JobTimeoutSec=30s

[Service]
Type=simple
User=cp0-compositor
Group=cp0-wayland
SupplementaryGroups=video render input cp0-display
RuntimeDirectory=cardputerzero
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
UMask=0007
Environment=XDG_RUNTIME_DIR=/run/cardputerzero
Environment=LIBSEAT_BACKEND=seatd
ExecStart=/usr/libexec/cardputerzero/start-compositor.sh
ExecStartPost=+/usr/libexec/cardputerzero/unblank-display.sh
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
MemoryMax=32M
MemorySwapMax=0
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cardputerzero -/sys/class/backlight/backlight/brightness
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
