[Unit]
Description=CardputerZero single-foreground Wayland compositor
Documentation=https://wayland.pages.freedesktop.org/weston/toc/running-weston.html
Requires=seatd.service
After=seatd.service systemd-user-sessions.service
RequiresMountsFor=/var/lib/cardputerzero/registry
Wants=cardputerzero-system-shell.service
Before=cardputerzero-system-shell.service
Conflicts=getty@tty1.service
OnFailure=getty@tty1.service
ConditionPathExists=/dev/dri/cardputer-zero-internal
ConditionPathExists=/dev/input/cardputer-zero-internal
ConditionPathExists=!/var/lib/cardputerzero/registry/recovery-mode

[Service]
Type=simple
User=cp0-compositor
Group=cp0-wayland
SupplementaryGroups=video render input
RuntimeDirectory=cardputerzero
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
UMask=0007
Environment=XDG_RUNTIME_DIR=/run/cardputerzero
Environment=LIBSEAT_BACKEND=seatd
ExecStart=/usr/libexec/cardputerzero/start-compositor.sh
ExecStartPost=+/usr/libexec/cardputerzero/unblank-display.sh
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cardputerzero
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
