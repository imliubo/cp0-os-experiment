[Unit]
Description=Hold the splash until the CardputerZero LCD is stable
Wants=cardputerzero-compositor.service
Before=cardputerzero-compositor.service cardputerzero-system-shell.service
ConditionPathExists=!/var/lib/cardputerzero/registry/recovery-mode

[Service]
Type=oneshot
ExecStart=/usr/libexec/cardputerzero/retry-display-once.sh
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# retry-display-once.sh reads /proc/uptime to avoid extending a late start.
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
