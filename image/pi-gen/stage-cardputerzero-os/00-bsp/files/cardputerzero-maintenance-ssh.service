[Unit]
Description=CardputerZero one-boot public-key maintenance access
Wants=NetworkManager.service
After=local-fs.target NetworkManager.service
Conflicts=ssh.service
ConditionPathExists=/boot/firmware/cp0-maintenance.enable
ConditionPathExists=/boot/firmware/cp0-maintenance.authorized_key

[Service]
Type=simple
ExecStartPre=/usr/libexec/cardputerzero/prepare-maintenance-ssh.sh
ExecStart=/usr/sbin/sshd -D -e -f /usr/lib/cardputerzero/maintenance-sshd_config
Restart=no
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
