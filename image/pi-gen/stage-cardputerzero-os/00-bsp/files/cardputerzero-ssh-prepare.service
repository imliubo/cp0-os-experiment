[Unit]
Description=Prepare the persistent CardputerZero SSH host identity
After=local-fs.target
Before=ssh.service
RequiresMountsFor=/etc/ssh
ConditionPathExists=/var/lib/cardputerzero/provisioning/complete
ConditionPathExists=/var/lib/cardputerzero/provisioning/ssh-enabled

[Service]
Type=oneshot
ExecStart=/usr/libexec/cardputerzero/prepare-ssh.sh
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/ssh
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
RequiredBy=ssh.service
