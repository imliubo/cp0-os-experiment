From: CardputerZero OS <os@cardputerzero.local>
Subject: [PATCH] Input: tca8418: standardize Shift and V0.6 Sym keys

Report the V0.6 physical Shift key as an ordinary held modifier. Remove its
one-shot, double-click lock, and long-press behavior so an unmodified letter
is lowercase and only a concurrently held Shift makes it uppercase.

Map the 32 Sym combinations by physical matrix scan code to the stable,
otherwise unreachable evdev identifiers used by the V0.6 keymap. Userspace
maps those identifiers directly to the printed symbols, so symbol input never
depends on a synthetic Shift event racing compositor modifier state.

---
diff --git a/modules/tca8418-1.0/tca8418_keypad_m5stack.c b/modules/tca8418-1.0/tca8418_keypad_m5stack.c
index fd452bf..064c7e7 100644
--- a/modules/tca8418-1.0/tca8418_keypad_m5stack.c
+++ b/modules/tca8418-1.0/tca8418_keypad_m5stack.c
@@ -195 +194,0 @@ struct tca8418_keypad {
-	ktime_t asmux_last_release;
@@ -197,9 +195,0 @@ struct tca8418_keypad {
-	bool asmux_second_click;
-	bool asmux_oneshot;
-	bool asmux_shift_active;
-	unsigned int asmux_shift_code;
-	bool asmux_locked;
-	bool asmux_unlock_pending;
-	bool asmux_longpress;
-	struct delayed_work asmux_longpress_work;
-	struct delayed_work asmux_blink_off_work;
@@ -211,0 +202,2 @@ struct tca8418_keypad {
+	bool *symbol_shift_synthetic;
+	unsigned int symbol_shift_count;
@@ -368,0 +361,58 @@ static void tca8418_report_key(struct tca8418_keypad *keypad_data,
+struct tca8418_symbol_translation {
+	unsigned int scan_code;
+	unsigned int keycode;
+	bool shifted;
+};
+
+static const struct tca8418_symbol_translation tca8418_symbols[] = {
+	/* Physical keys from the CardputerZero V0.6 Sym legend. */
+	{ 0x44, KEY_LEFTBRACE, false },
+	{ 0x00, KEY_RIGHTBRACE, false },
+	{ 0x01, KEY_SEMICOLON, false },
+	{ 0x02, KEY_APOSTROPHE, false },
+	{ 0x03, KEY_GRAVE, false },
+	{ 0x04, KEY_BACKSLASH, false },
+	{ 0x05, KEY_COMMA, false },
+	{ 0x06, KEY_DOT, false },
+	{ 0x07, KEY_SLASH, false },
+	{ 0x08, KEY_MUHENKAN, false },
+	{ 0x10, KEY_KPASTERISK, false },
+	{ 0x11, KEY_NUMLOCK, false },
+	{ 0x12, KEY_SCROLLLOCK, false },
+	{ 0x13, KEY_KP7, false },
+	{ 0x14, KEY_KP8, false },
+	{ 0x15, KEY_KP9, false },
+	{ 0x16, KEY_KPMINUS, false },
+	{ 0x17, KEY_KP4, false },
+	{ 0x18, KEY_KP5, false },
+	{ 0x19, KEY_KP6, false },
+	{ 0x20, KEY_KP1, false },
+	{ 0x21, KEY_KP2, false },
+	{ 0x22, KEY_KP3, false },
+	{ 0x24, KEY_KP0, false },
+	{ 0x25, KEY_KPDOT, false },
+	{ 0x26, KEY_ZENKAKUHANKAKU, false },
+	{ 0x27, KEY_102ND, false },
+	{ 0x28, KEY_RO, false },
+	{ 0x35, KEY_KATAKANA, false },
+	{ 0x36, KEY_HIRAGANA, false },
+	{ 0x37, KEY_HENKAN, false },
+	{ 0x38, KEY_KATAKANAHIRAGANA, false },
+};
+
+static bool tca8418_translate_symbol_key(unsigned int scan_code,
+					 unsigned int *keycode, bool *shifted)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(tca8418_symbols); i++) {
+		if (tca8418_symbols[i].scan_code != scan_code)
+			continue;
+		*keycode = tca8418_symbols[i].keycode;
+		*shifted = tca8418_symbols[i].shifted;
+		return true;
+	}
+
+	return false;
+}
+
@@ -416,5 +466,2 @@ static void tca8418_asmux_deactivate(struct tca8418_keypad *keypad_data)
-	cancel_delayed_work_sync(&keypad_data->asmux_longpress_work);
-	cancel_delayed_work_sync(&keypad_data->asmux_blink_off_work);
-
-	if (keypad_data->asmux_locked || keypad_data->asmux_shift_active ||
-	    keypad_data->asmux_longpress)
+	if (keypad_data->asmux_pressed &&
+	    keypad_data->symbol_shift_count == 0) {
@@ -422,0 +470,2 @@ static void tca8418_asmux_deactivate(struct tca8418_keypad *keypad_data)
+		input_sync(keypad_data->input);
+	}
@@ -425,6 +473,0 @@ static void tca8418_asmux_deactivate(struct tca8418_keypad *keypad_data)
-	keypad_data->asmux_second_click = false;
-	keypad_data->asmux_oneshot = false;
-	keypad_data->asmux_shift_active = false;
-	keypad_data->asmux_locked = false;
-	keypad_data->asmux_unlock_pending = false;
-	keypad_data->asmux_longpress = false;
@@ -509,39 +552,3 @@ static void tca8418_asmux_update_led(struct tca8418_keypad *keypad_data)
-	if (keypad_data->asmux_longpress)
-		tca8418_led_set(&keypad_data->capslock_led_ctl,
-				TCA8418_LED_ON);
-	else if (keypad_data->asmux_locked)
-		tca8418_led_set(&keypad_data->capslock_led_ctl,
-				TCA8418_LED_FAST);
-	else if (keypad_data->asmux_oneshot)
-		tca8418_led_set(&keypad_data->capslock_led_ctl,
-				TCA8418_LED_BLINK);
-	else
-		tca8418_led_set(&keypad_data->capslock_led_ctl,
-				keypad_data->capslock_state ? TCA8418_LED_ON :
-				TCA8418_LED_OFF);
-}
-
-static void tca8418_asmux_blink_off_work(struct work_struct *work)
-{
-	struct tca8418_keypad *keypad_data =
-		container_of(to_delayed_work(work), struct tca8418_keypad,
-			     asmux_blink_off_work);
-
-	if (!keypad_data->asmux_pressed && !keypad_data->asmux_oneshot &&
-	    !keypad_data->asmux_locked && !keypad_data->asmux_longpress)
-		tca8418_asmux_update_led(keypad_data);
-}
-
-static void tca8418_asmux_longpress_work(struct work_struct *work)
-{
-	struct tca8418_keypad *keypad_data =
-		container_of(to_delayed_work(work), struct tca8418_keypad,
-			     asmux_longpress_work);
-
-	if (!keypad_data->asmux_pressed || keypad_data->asmux_locked)
-		return;
-
-	keypad_data->asmux_longpress = true;
-	tca8418_report_key(keypad_data, keypad_data->asmux_button_code,
-			    KEY_LEFTSHIFT, true);
-	tca8418_asmux_update_led(keypad_data);
+	tca8418_led_set(&keypad_data->capslock_led_ctl,
+			keypad_data->asmux_pressed || keypad_data->capslock_state ?
+			TCA8418_LED_ON : TCA8418_LED_OFF);
@@ -553 +560 @@ static void tca8418_handle_asmux_key(struct tca8418_keypad *keypad_data,
-	if (pressed) {
+	if (pressed)
@@ -555,29 +562 @@ static void tca8418_handle_asmux_key(struct tca8418_keypad *keypad_data,
-
-		cancel_delayed_work_sync(&keypad_data->asmux_blink_off_work);
-		keypad_data->asmux_pressed = true;
-		keypad_data->asmux_longpress = false;
-
-		if (keypad_data->asmux_locked) {
-			keypad_data->asmux_unlock_pending = true;
-			keypad_data->asmux_second_click = false;
-			return;
-		}
-
-		if (keypad_data->asmux_oneshot) {
-			keypad_data->asmux_oneshot = false;
-			if (tca8418_time_before_ms(keypad_data->asmux_last_release,
-						   TCA8418_DBLCLICK_MS)) {
-				keypad_data->asmux_locked = true;
-				tca8418_report_key(keypad_data, scan_code,
-						    KEY_LEFTSHIFT, true);
-			} else {
-				keypad_data->asmux_second_click = true;
-			}
-			tca8418_asmux_update_led(keypad_data);
-			return;
-		}
-
-		keypad_data->asmux_oneshot = false;
-
-		schedule_delayed_work(&keypad_data->asmux_longpress_work,
-			msecs_to_jiffies(TCA8418_LONGPRESS_MS));
+	if (keypad_data->asmux_pressed == pressed)
@@ -585,3 +563,0 @@ static void tca8418_handle_asmux_key(struct tca8418_keypad *keypad_data,
-	}
-
-	cancel_delayed_work_sync(&keypad_data->asmux_longpress_work);
@@ -589,29 +565,4 @@ static void tca8418_handle_asmux_key(struct tca8418_keypad *keypad_data,
-	if (!keypad_data->asmux_pressed)
-		return;
-
-	keypad_data->asmux_pressed = false;
-
-	if (keypad_data->asmux_unlock_pending) {
-		keypad_data->asmux_unlock_pending = false;
-		keypad_data->asmux_locked = false;
-		tca8418_report_key(keypad_data, scan_code, KEY_LEFTSHIFT, false);
-		tca8418_asmux_update_led(keypad_data);
-		return;
-	}
-
-	if (keypad_data->asmux_second_click) {
-		keypad_data->asmux_second_click = false;
-		tca8418_asmux_update_led(keypad_data);
-		return;
-	}
-
-	keypad_data->asmux_second_click = false;
-
-	if (keypad_data->asmux_longpress) {
-		tca8418_report_key(keypad_data, scan_code, KEY_LEFTSHIFT, false);
-		keypad_data->asmux_longpress = false;
-		tca8418_asmux_update_led(keypad_data);
-	} else if (!keypad_data->asmux_locked) {
-		keypad_data->asmux_oneshot = true;
-		keypad_data->asmux_last_release = ktime_get();
-		tca8418_asmux_update_led(keypad_data);
+	keypad_data->asmux_pressed = pressed;
+	if (keypad_data->symbol_shift_count == 0) {
+		tca8418_report_key(keypad_data, scan_code, KEY_LEFTSHIFT, pressed);
+		input_sync(keypad_data->input);
@@ -619,41 +569,0 @@ static void tca8418_handle_asmux_key(struct tca8418_keypad *keypad_data,
-}
-
-static void tca8418_consume_asmux_oneshot(struct tca8418_keypad *keypad_data,
-					  unsigned int scan_code)
-{
-	if (!keypad_data->asmux_oneshot)
-		return;
-
-	keypad_data->asmux_oneshot = false;
-	keypad_data->asmux_shift_active = true;
-	keypad_data->asmux_shift_code = scan_code;
-	cancel_delayed_work_sync(&keypad_data->asmux_blink_off_work);
-	tca8418_report_key(keypad_data, scan_code, KEY_LEFTSHIFT, true);
-	tca8418_asmux_update_led(keypad_data);
-}
-
-static void tca8418_activate_asmux_hold(struct tca8418_keypad *keypad_data)
-{
-	if (!keypad_data->asmux_pressed || keypad_data->asmux_locked ||
-	    keypad_data->asmux_longpress)
-		return;
-
-	cancel_delayed_work_sync(&keypad_data->asmux_longpress_work);
-	if (keypad_data->asmux_longpress)
-		return;
-
-	keypad_data->asmux_longpress = true;
-	tca8418_report_key(keypad_data, keypad_data->asmux_button_code,
-			    KEY_LEFTSHIFT, true);
-	tca8418_asmux_update_led(keypad_data);
-}
-
-static void tca8418_release_asmux_oneshot(struct tca8418_keypad *keypad_data,
-					  unsigned int scan_code)
-{
-	if (!keypad_data->asmux_shift_active ||
-	    keypad_data->asmux_shift_code != scan_code)
-		return;
-
-	keypad_data->asmux_shift_active = false;
-	tca8418_report_key(keypad_data, scan_code, KEY_LEFTSHIFT, false);
@@ -687,0 +598 @@ static void tca8418_handle_key_new(struct tca8418_keypad *keypad_data,
+		bool symbol_shifted = false;
@@ -695 +606,3 @@ static void tca8418_handle_key_new(struct tca8418_keypad *keypad_data,
-			report_code = keypad_data->keycode1[code];
+			if (!tca8418_translate_symbol_key(code, &report_code,
+							  &symbol_shifted))
+				report_code = KEY_RESERVED;
@@ -705,2 +617,0 @@ static void tca8418_handle_key_new(struct tca8418_keypad *keypad_data,
-		tca8418_activate_asmux_hold(keypad_data);
-		tca8418_consume_asmux_oneshot(keypad_data, code);
@@ -707,0 +619,9 @@ static void tca8418_handle_key_new(struct tca8418_keypad *keypad_data,
+		keypad_data->symbol_shift_synthetic[code] = symbol_shifted;
+		if (keypad_data->symbol_shift_synthetic[code]) {
+			if (keypad_data->symbol_shift_count++ == 0 &&
