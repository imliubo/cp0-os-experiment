CP0_STORE_DATABASE_URL=postgresql://cp0_store_publisher@/cp0store?host=/run/postgresql
CP0_STORE_OBJECT_ROOT=/var/lib/cardputerzero-store/objects
CP0_STORE_ORIGIN_ROOT=/var/lib/cardputerzero-store/origin
CP0_STORE_SIGNING_KEY=/etc/cardputerzero/store-signing.key
CP0_STORE_PUBLIC_BASE_URL=https://store.example.invalid
CP0_STORE_PUBLISHER_ID=publisher-primary
