[Unit]
Description=CardputerZero Store isolated package and Catalog publisher
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=cp0-store-publisher
Group=cp0-store-publisher
EnvironmentFile=/etc/cardputerzero/store-publisher.env
ExecStart=/usr/local/libexec/cp0-store-publisher
Restart=on-failure
RestartSec=2s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/var/lib/cardputerzero-store/objects
ReadOnlyPaths=/etc/cardputerzero/store-signing.key
ReadWritePaths=/var/lib/cardputerzero-store/origin
InaccessiblePaths=/home /root
TasksMax=32
MemoryMax=192M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
