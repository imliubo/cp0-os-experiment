[Unit]
Description=CardputerZero Store isolated submission scanner
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=cp0-store-scan
Group=cp0-store-scan
EnvironmentFile=/etc/cardputerzero/store-scan-worker.env
ExecStart=/usr/local/libexec/cp0-store-scan-worker
Restart=on-failure
RestartSec=2s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/var/lib/cardputerzero-store/objects
InaccessiblePaths=/home /root
TasksMax=32
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
