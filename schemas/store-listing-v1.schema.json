{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputerzero.dev/schemas/store-listing-v1.schema.json",
  "title": "CardputerZero Store listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "version",
    "default_locale",
    "category",
    "age_rating",
    "privacy_url",
    "support_url",
    "icon",
    "screenshots",
    "localizations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "app_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)*$"
    },
    "default_locale": { "$ref": "#/$defs/locale" },
    "category": {
      "enum": [
        "developer-tools",
        "education",
        "entertainment",
        "games",
        "hardware",
        "media",
        "productivity",
        "utilities"
      ]
    },
    "age_rating": { "enum": ["4+", "9+", "12+", "17+"] },
    "privacy_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^@/#\\s]+\\.[^@/#\\s]+(?:/[^#\\s]*)?$"
    },
    "support_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^@/#\\s]+\\.[^@/#\\s]+(?:/[^#\\s]*)?$"
    },
    "icon": { "$ref": "#/$defs/icon" },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/screenshot" }
    },
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/localization" }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "width", "height"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*\\.png$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "icon": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "properties": {
            "bytes": { "maximum": 65536 },
            "width": { "const": 48 },
            "height": { "const": 48 }
          }
        }
      ]
    },
    "screenshot": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "properties": {
            "bytes": { "maximum": 524288 },
            "width": { "const": 320 },
            "height": { "const": 170 }
          }
        }
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "name",
        "subtitle",
        "description",
        "keywords",
        "release_notes"
      ],
      "properties": {
        "locale": { "$ref": "#/$defs/locale" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "keywords": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 24 }
        },
        "release_notes": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
