{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputerzero.dev/schemas/store-review-v1.schema.json",
  "title": "CardputerZero store review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "app_id",
    "version",
    "submission_sha256",
    "summary",
    "reviewer",
    "reviewed_unix_seconds",
    "approved_permissions",
    "approved_imports"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision": { "enum": ["approved", "rejected"] },
    "app_id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)*$"
    },
    "submission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 96 },
    "reviewer": { "type": "string", "minLength": 3, "maxLength": 64 },
    "reviewed_unix_seconds": { "type": "integer", "minimum": 1 },
    "approved_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio.capture",
          "audio.playback",
          "camera.capture",
          "documents.open",
          "hardware.gpio",
          "network.client",
          "notifications.post",
          "radio.lora"
        ]
      }
    },
    "approved_imports": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^cp0_[a-z0-9_]+$" }
    }
  }
}
