{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardputerzero.dev/schemas/os-release-v1.schema.json",
  "title": "CardputerZero OS authenticated release metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "board_id",
    "version",
    "sequence",
    "data_layout_min",
    "data_layout_max",
    "rootfs",
    "verity",
    "fit"
  ],
  "properties": {
    "format": {
      "const": "cp0-os-release-v1"
    },
    "board_id": {
      "const": "cardputerzero-cm0-v0.6"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "data_layout_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "data_layout_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "rootfs": {
      "$ref": "#/$defs/artifact"
    },
    "verity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_hash", "salt", "data_blocks", "hash_tree"],
      "properties": {
        "root_hash": {
          "$ref": "#/$defs/sha256"
        },
        "salt": {
          "type": "string",
          "pattern": "^([0-9a-f]{2}){16,64}$"
        },
        "data_blocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2199023255551
        },
        "hash_tree": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "configuration"],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "configuration": {
          "enum": ["conf-a", "conf-b"]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
