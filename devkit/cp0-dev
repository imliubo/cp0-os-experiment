#!/usr/bin/env bash
set -euo pipefail

image=${CP0_DEVKIT_IMAGE:-cardputerzero/app-devkit:1.0.0}
project=${1:-$PWD}

if [[ ! -d $project ]]; then
    echo "error: project directory does not exist: $project" >&2
    exit 2
fi
project=$(cd "$project" && pwd -P)

exec docker run --rm -it \
    --mount "type=bind,source=$project,target=/workspace" \
    --workdir /workspace \
    "$image"
