package cardputerzero:sdk@0.1.0;

interface types {
    enum lifecycle-state {
        foreground,
        background,
        suspended,
        terminating,
    }

    record rect {
        x: u16,
        y: u16,
        width: u16,
        height: u16,
    }

    record key-event {
        code: u16,
        pressed: bool,
        repeated: bool,
        modifiers: u8,
    }

    variant app-event {
        key(key-event),
        lifecycle(lifecycle-state),
        render,
    }

    enum error-code {
        denied,
        unavailable,
        invalid-argument,
        resource-limit,
        internal,
    }
}

interface system {
    use types.{error-code};

    monotonic-milliseconds: func() -> u64;
    log: func(level: u8, message: string);
    post-notification: func(title: string, body: string) -> result<_, error-code>;
}

interface display {
    use types.{error-code, rect};

    dimensions: func() -> tuple<u16, u16>;
    present-rgb565: func(pixels: list<u8>, damage: list<rect>) -> result<_, error-code>;
}

interface network {
    use types.{error-code};

    record http-response {
        status-code: u16,
        body: list<u8>,
    }

    http-get: func(url: string) -> result<http-response, error-code>;
}

interface documents {
    use types.{error-code};

    record document {
        handle: u32,
        length: u32,
    }

    open: func() -> result<document, error-code>;
    read: func(handle: u32, offset: u64, maximum: u32) -> result<list<u8>, error-code>;
    close: func(handle: u32) -> result<_, error-code>;
}

interface audio {
    use types.{error-code};

    play-pcm-s16le: func(samples: list<s16>) -> result<_, error-code>;
    capture-pcm-s16le: func(frames: u16) -> result<list<s16>, error-code>;
}

interface camera {
    use types.{error-code};

    capture-rgb565: func() -> result<list<u16>, error-code>;
}

interface gpio {
    use types.{error-code};

    enum line {
        grove-function,
        external-usb-function,
        grove-5v-power,
        external-5v-power,
    }

    read: func(line: line) -> result<bool, error-code>;
    write: func(line: line, value: bool) -> result<_, error-code>;
}

interface radio {
    use types.{error-code};

    record metadata {
        rssi-dbm: s16,
        snr-quarter-db: s8,
    }

    record packet {
        payload: list<u8>,
        metadata: metadata,
    }

    send-lora: func(payload: list<u8>) -> result<_, error-code>;
    receive-lora: func(timeout-ms: u16) -> result<option<packet>, error-code>;
}

interface storage {
    use types.{error-code};

    put: func(key: string, value: list<u8>) -> result<_, error-code>;
    get: func(key: string, maximum: u16) -> result<option<list<u8>>, error-code>;
    delete: func(key: string) -> result<bool, error-code>;
}

interface application {
    use types.{app-event, error-code};

    initialize: func() -> result<_, error-code>;
    handle-event: func(event: app-event) -> result<_, error-code>;
}

world cardputer-application {
    import system;
    import display;
    import network;
    import documents;
    import audio;
    import camera;
    import gpio;
    import radio;
    import storage;
    export application;
}
