package cardputerzero:sdk@1.0.0;

interface types {
    record rect {
        x: u16,
        y: u16,
        width: u16,
        height: u16,
    }

    record key-event {
        code: u16,
        pressed: bool,
        repeated: bool,
        modifiers: u8,
    }

    enum error-code {
        denied,
        unavailable,
        invalid-argument,
        resource-limit,
        internal,
    }
}

interface system {
    use types.{error-code};

    monotonic-milliseconds: func() -> u64;
    wait-event: func(timeout-ms: u32) -> result<_, error-code>;
    post-notification: func(title: string, body: string) -> result<_, error-code>;
}

interface input {
    use types.{error-code, key-event};

    poll-key-event: func(timeout-ms: u32) -> result<option<key-event>, error-code>;
}

interface display {
    use types.{error-code, rect};

    dimensions: func() -> tuple<u16, u16>;
    present-rgb565: func(pixels: list<u8>, damage: list<rect>) -> result<_, error-code>;
}

interface network {
    use types.{error-code};

    record http-response {
        status-code: u16,
        body: list<u8>,
    }

    http-get: func(url: string) -> result<http-response, error-code>;
}

interface documents {
    use types.{error-code};

    record document {
        handle: u32,
        length: u32,
    }

    open: func() -> result<document, error-code>;
    read: func(handle: u32, offset: u64, maximum: u32) -> result<list<u8>, error-code>;
    close: func(handle: u32) -> result<_, error-code>;
}

interface audio {
    use types.{error-code};

    play-pcm-s16le: func(samples: list<s16>) -> result<_, error-code>;
    capture-pcm-s16le: func(frames: u16) -> result<list<s16>, error-code>;
}

interface camera {
    use types.{error-code};

    capture-rgb565: func() -> result<list<u16>, error-code>;
}

interface gpio {
    use types.{error-code};

    enum line {
        grove-function,
        external-usb-function,
        grove-5v-power,
        external-5v-power,
    }

    read: func(line: line) -> result<bool, error-code>;
    write: func(line: line, value: bool) -> result<_, error-code>;
}

interface radio {
    use types.{error-code};

    record metadata {
        rssi-dbm: s16,
        snr-quarter-db: s8,
    }

    record packet {
        payload: list<u8>,
        metadata: metadata,
    }

    send-lora: func(payload: list<u8>) -> result<_, error-code>;
    receive-lora: func(timeout-ms: u32) -> result<option<packet>, error-code>;
}

interface storage {
    use types.{error-code};

    put: func(key: string, value: list<u8>) -> result<_, error-code>;
    get: func(key: string, maximum: u32) -> result<option<list<u8>>, error-code>;
    delete: func(key: string) -> result<bool, error-code>;
}

interface photos {
    use types.{error-code};

    put: func(key: string, value: list<u8>) -> result<_, error-code>;
    get: func(key: string, maximum: u32) -> result<option<list<u8>>, error-code>;
    get-index-for-update: func(maximum: u32) -> result<option<list<u8>>, error-code>;
    delete: func(key: string) -> result<bool, error-code>;
    import-rgb565: func(pixels: list<u8>, suggested-id: u64) -> result<u64, error-code>;
    remove: func(photo-id: u64) -> result<bool, error-code>;
}

interface intents {
    use types.{error-code};

    record message {
        action: string,
        payload: list<u8>,
    }

    send: func(action: string, payload: list<u8>) -> result<_, error-code>;
    take: func() -> result<option<message>, error-code>;
}

interface media {
    use types.{error-code};

    enum playback-state {
        inactive,
        paused,
        playing,
    }

    flags action-capabilities {
        play-pause,
        previous,
        next,
    }

    enum action {
        play-pause,
        previous,
        next,
    }

    update-session: func(state: playback-state, supported-actions: action-capabilities) -> result<_, error-code>;
    take-action: func() -> result<option<action>, error-code>;
}

interface application {
    run: func() -> s32;
}

interface lifecycle {
    use types.{error-code};

    record saved-state {
        schema-version: u32,
        payload: list<u8>,
    }

    checkpoint: func() -> result<saved-state, error-code>;
    restore: func(saved: saved-state) -> result<_, error-code>;
}

world cardputer-application {
    import system;
    import display;
    import input;
    import network;
    import documents;
    import audio;
    import camera;
    import gpio;
    import radio;
    import storage;
    import photos;
    import intents;
    import media;
    export application;
}

world cardputer-multitask-application {
    include cardputer-application;
    export lifecycle;
}
